# Copie este arquivo para .env (ignorado pelo git) e ajuste os valores.
# POSTGRES_PASSWORD: use so letras e numeros (vai embutida na connection string).
POSTGRES_PASSWORD=change-me
# SEED_USER_EMAIL: precisa ser um e-mail valido.
SEED_USER_EMAIL=you@example.com
# SEED_USER_PASSWORD: minimo de 12 caracteres e ao menos 1 caractere nao alfanumerico
# (politica de senha do Identity).
SEED_USER_PASSWORD=change-me-with-12-chars-or-more
